#!/bin/sh
# Embed the audited fork's desktop agent during ISO creation (never at user login).
set -eu
set -- /opt/mjon-ai-os/wheels/*.whl
if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
  echo 'MJON: expected exactly one locally built agent wheel' >&2
  exit 1
fi
# Fail at image construction rather than giving the user an unusable desktop.
# These binaries are the actual graphical settings center and WPA Wi-Fi engine.
for required in /usr/bin/systemsettings /usr/sbin/wpa_supplicant /usr/sbin/rfkill; do
  if [ ! -x "$required" ]; then
    echo "MJON Control Center: missing required OS executable $required" >&2
    exit 1
  fi
done
test -f /usr/share/applications/mjon-control-center.desktop
test -x /etc/skel/Desktop/Centro-de-mando-MJON.desktop
# Debian distributes GTK GI bindings in its system Python, not as generic pip wheels.
# Allow this interpreter to see only the system packages plus the isolated venv.
/usr/bin/python3 -m venv --system-site-packages /opt/mjon-ai-os/venv
# The local wheel is the product. Its [desktop] extra installs pywebview,
# screenshot tools, and the desktop-specific dependencies.
# Prefer wheels, but permit source dependencies that lack binary distributions.
/opt/mjon-ai-os/venv/bin/python -m pip install --no-cache-dir --prefer-binary "$1[desktop]"
/opt/mjon-ai-os/venv/bin/python -c 'import dodaios, mjon_jarvis, mjon_os, webview'
# Real AI control plane and local inference adapter must ship with the image.
# This is read-only; it never downloads optional models at image or first boot.
/opt/mjon-ai-os/venv/bin/python -c 'from mjon_os.ai_fabric import CATALOG, plan_capability, HardwareProfile; from mjon_os.local_inference import OllamaClient; assert len(CATALOG) >= 45; assert OllamaClient.DEFAULT_ENDPOINT == "http://127.0.0.1:11434"'
# The genuine local-only provider guard and full-stream readiness checker
# must be importable in the installed wheel, not just in source checkout.
/opt/mjon-ai-os/venv/bin/python -c 'from mjon_os.provider_health import diagnose, preload; from mjon_os.local_inference import is_cloud_model; from dodaios.brain.healthcheck import BrainHealthChecker; assert is_cloud_model("gemma4:cloud") and not is_cloud_model("local:tiny"); assert diagnose and preload and BrainHealthChecker'
/opt/mjon-ai-os/venv/bin/python -m mjon_os.ai_center --status-json >/dev/null
# Check the exact missing import from the first real laptop run. A healthy
# /api/health endpoint is not enough if the UI's Verse routes fail to import.
/opt/mjon-ai-os/venv/bin/python -c 'from dodaios.verse_host.relays.chat_tails import ChatTailsRelay; from dodaios.verse_host.host import VerseHost; assert ChatTailsRelay and VerseHost'
/opt/mjon-ai-os/venv/bin/python -c 'import gi; gi.require_version("Gtk", "3.0"); gi.require_version("WebKit2", "4.1"); from gi.repository import Gtk, WebKit2'
# The whole OS ships a single native agent: verify the real action router.
MJON_NATIVE_OS=1 /opt/mjon-ai-os/venv/bin/python -c 'from dodaios.brain.local_action_gate import match_local_action; p = match_local_action("Jarvis, abrí calculadora", lang="es"); assert p and p.tool_calls[0].name == "open_app" and p.tool_calls[0].args == {"app_name": "kcalc"}'

# This service runs only under virtualized Linux and reports graphical boot
# via the emulated serial port; normal USB hardware does not run it.
mkdir -p /etc/systemd/system/graphical.target.wants
ln -s /usr/lib/systemd/system/mjon-vm-proof.service \
  /etc/systemd/system/graphical.target.wants/mjon-vm-proof.service

# Avoid distributing an extra redundant installer payload inside the Live filesystem.
rm -rf /opt/mjon-ai-os/wheels
