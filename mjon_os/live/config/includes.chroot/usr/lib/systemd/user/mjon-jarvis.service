[Unit]
Description=MJON AI OS - native JARVIS desktop agent
Documentation=https://github.com/miqueas80/MJON-JARVIS-ULTIMATE
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=/usr/local/bin/mjon-session
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
