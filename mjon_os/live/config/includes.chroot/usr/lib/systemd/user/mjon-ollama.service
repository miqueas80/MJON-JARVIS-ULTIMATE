[Unit]
Description=MJON AI OS - bundled offline CPU Ollama
ConditionPathExists=/opt/mjon-ai-os/ollama/manifest.json

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=%h/.local/share/mjon-ai-os/ollama-models
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_VULKAN=0
Environment=CUDA_VISIBLE_DEVICES=-1
ExecStartPre=/opt/mjon-ai-os/venv/bin/python -m mjon_os.offline_payload --payload /opt/mjon-ai-os/ollama --initialize-store %h/.local/share/mjon-ai-os/ollama-models
ExecStart=/opt/mjon-ai-os/ollama/runtime/bin/ollama serve
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStartSec=120
