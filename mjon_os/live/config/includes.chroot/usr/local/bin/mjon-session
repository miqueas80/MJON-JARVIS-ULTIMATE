#!/bin/sh
# A single native JARVIS instance, launched as the logged-in KDE user.
set -eu
: "${HOME:?HOME must be set by the graphical user session}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}/mjon-ai-os"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}/mjon-ai-os"
export MJON_AI_OS_CONFIG_ROOT="$config_home"
export JARVIS_DATA_DIR="$data_home"
export JARVIS_INSTANCE=default
export MJON_NATIVE_OS=1
# KDE makes pywebview prefer Qt; use the already validated Debian GTK/WebKit
# backend instead of importing the observed incompatible Qt wheel path.
export PYWEBVIEW_GUI=gtk
# Applies to any explicitly spawned daemon; an existing system daemon needs
# its own cloud-disabled configuration and offline acceptance.
export OLLAMA_NO_CLOUD=1
engine=/opt/mjon-ai-os/venv/bin/python
# An offline payload is included only by an explicit image-builder choice.
# The base image still starts no optional inference engine.
if [ -f /opt/mjon-ai-os/ollama/manifest.json ]; then
  export PATH="/opt/mjon-ai-os/ollama/runtime/bin:$PATH"
  export OLLAMA_MODELS="$HOME/.local/share/mjon-ai-os/ollama-models"
  # Queue the independent engine without blocking the desktop on cold image
  # verification. Successful queueing is not provider or model readiness.
  if ! systemctl --user start --no-block mjon-ollama.service; then
    echo 'MJON: could not queue bundled Ollama startup; keeping the desktop available for diagnosis.' >&2
  fi
fi
"$engine" -m mjon_os.first_boot \
  --template /usr/share/mjon-ai-os/dodaios.toml.example \
  --config "$config_home/dodaios.toml" --data "$data_home"
exec "$engine" -m dodaios.ui.web.launcher
