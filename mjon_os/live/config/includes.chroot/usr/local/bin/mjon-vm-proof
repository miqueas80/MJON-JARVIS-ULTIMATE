#!/bin/sh
# VM-only guest checks. No network, host disk access or account modifications.
set -eu
[ -c /dev/ttyS0 ] || exit 0
emit() { printf 'MJON_VM_PROOF %s\n' "$1" > /dev/ttyS0; }
emit KERNEL_RUNNING
if systemctl is-active --quiet display-manager.service; then
  emit DISPLAY_MANAGER_ACTIVE
fi

# A visible KDE greeter is NOT evidence of a working live user (hardware
# regression: first ISO had an inaccessible account).
if id user >/dev/null 2>&1 && [ -d /home/user ] && \
   [ "$(passwd -S user 2>/dev/null | awk '{print $2}')" = "P" ]; then
  if printf '%s\n' 'live' | timeout 10 pamtester login user authenticate >/dev/null 2>&1; then
    emit LIVE_USER_READY
  else
    emit LIVE_USER_AUTH_FAILED
    exit 1
  fi
else
  emit LIVE_USER_MISSING
  exit 1
fi

# Fail image verification if the installed guest lacks its actual graphical
# configuration tool. Do not confuse a menu entry with a working settings app.
if [ -x /usr/bin/systemsettings ] && [ -x /usr/sbin/wpa_supplicant ] && \
   [ -f /usr/share/applications/mjon-control-center.desktop ] && \
   [ -x /usr/local/bin/mjon-control-center ]; then
  emit CONTROL_CENTER_READY
else
  emit CONTROL_CENTER_MISSING
  exit 1
fi

# SDDM autologin and KDE Plasma can take longer than the login greeter itself.
# Confirm a real Plasma session process before claiming a working desktop.
uid="$(id -u user)"
i=0
while [ "$i" -lt 120 ]; do
  if pgrep -u user -x plasmashell >/dev/null 2>&1; then
    emit PLASMA_DESKTOP_ACTIVE
    break
  fi
  i=$((i+1))
  sleep 1
done
if ! pgrep -u user -x plasmashell >/dev/null 2>&1; then
  emit PLASMA_DESKTOP_MISSING
  exit 1
fi

# The OS-owned JARVIS process must remain alive after KDE has started.
# Query only the logged-in user's user service; do not grant root to JARVIS.
service_active() {
  [ -S "/run/user/$uid/bus" ] || return 1
  runuser -u user -- env \
    XDG_RUNTIME_DIR="/run/user/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
    systemctl --user is-active --quiet mjon-jarvis.service || return 1
  pgrep -u user -f 'dodaios.ui.web.launcher' >/dev/null 2>&1
}
i=0
while [ "$i" -lt 120 ]; do
  if service_active; then
    sleep 5
    if service_active; then
      emit JARVIS_SERVICE_STABLE
      # A running Python process alone is not an operational assistant.
      # The native desktop must also respond on its loopback health endpoint.
      # Never attempt an external network request from the isolated VM.
      j=0
      while [ "$j" -lt 80 ]; do
        if curl -fsS --noproxy '*' --max-time 2 \
            http://127.0.0.1:47821/api/health >/dev/null 2>&1; then
          if [ -f /opt/mjon-ai-os/ollama/manifest.json ]; then
            # This proves packaged runtime and model discovery, not inference.
            if curl -fsS --noproxy '*' --max-time 5 \
                http://127.0.0.1:11434/api/tags | /opt/mjon-ai-os/venv/bin/python -c \
                'import json,sys; expected=json.load(open("/opt/mjon-ai-os/ollama/manifest.json"))["model"]; assert any(m.get("name")==expected for m in json.load(sys.stdin)["models"])'; then
              emit OLLAMA_PAYLOAD_READY
            else
              emit OLLAMA_PAYLOAD_FAILED
              exit 1
            fi
          fi
          emit JARVIS_API_READY
          exit 0
        fi
        j=$((j+1))
        sleep 1
      done
      emit JARVIS_API_NOT_READY
      exit 1
    fi
  fi
  i=$((i+1))
  sleep 1
done
emit JARVIS_SERVICE_NOT_READY
exit 1
