#!/bin/sh
# Virtual machine only: send deterministic guest proof to an isolated serial port.
# No network access, no modification of host partitions or guest user state.
set -eu
[ -c /dev/ttyS0 ] || exit 0
printf 'MJON_VM_PROOF KERNEL_RUNNING\n' > /dev/ttyS0
if systemctl is-active --quiet display-manager.service; then
  printf 'MJON_VM_PROOF DISPLAY_MANAGER_ACTIVE\n' > /dev/ttyS0
fi
