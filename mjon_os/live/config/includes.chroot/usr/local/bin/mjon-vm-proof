#!/bin/sh
# Virtual machine only: send deterministic guest proof to an isolated serial port.
# No network access, no modification of host partitions or guest user state.
set -eu
[ -c /dev/ttyS0 ] || exit 0
printf 'MJON_VM_PROOF KERNEL_RUNNING\n' > /dev/ttyS0
if systemctl is-active --quiet display-manager.service; then
  printf 'MJON_VM_PROOF DISPLAY_MANAGER_ACTIVE\n' > /dev/ttyS0
fi
# A visible greeter is NOT proof that a real live account exists. An earlier
# image passed the graphical checks but failed to authenticate on real hardware.
# Fail closed unless live-config created the user, home and usable password.
if id user >/dev/null 2>&1 && [ -d /home/user ] && \
   [ "$(passwd -S user 2>/dev/null | awk '{print $2}')" = "P" ]; then
  # Test actual Debian Live default credentials through PAM. No account
  # changes are performed, and credentials are never written to the log.
  if printf '%s\n' 'live' | timeout 10 pamtester login user authenticate >/dev/null 2>&1; then
    printf 'MJON_VM_PROOF LIVE_USER_READY\n' > /dev/ttyS0
  fi
fi
