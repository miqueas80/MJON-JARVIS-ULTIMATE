# Debian 13 KDE desktop, native session integration, and voice/desktop dependencies.
live-task-kde
# Required for a visible login screen when apt recommends are disabled.
sddm
sddm-theme-debian-breeze
xserver-xorg
libpam-systemd
# Debian Live needs user-setup and sudo explicitly when APT recommends are disabled.
# Without user-setup, agetty/SDDM try to authenticate 'user' before it exists.
live-boot
live-config
live-config-systemd
user-setup
sudo
# Temporary debug proof for the public Debian Live user/live PAM credentials.
pamtester
# Harmless desktop apps guaranteed for Spanish Jarvis smoke tests.
kate
kcalc
dolphin
konsole
# Usable web browser even when apt recommends are disabled.
firefox-esr
locales
network-manager
# Required by NetworkManager for WPA/WPA2/WPA3 on Debian. We explicitly
# disable apt recommends, so these do not get included automatically.
# First real USB test on Realtek RTL8822CE showed wlp1s0 unavailable despite
# loaded rtw_8822ce firmware and enabled Wi-Fi hardware radio.
wpasupplicant
wireless-regdb
rfkill
plasma-nm
# Full graphical Control Center, just like Settings on Windows.
# These are only recommends of plasma-desktop, but our ISO disables recommends.
systemsettings
plasma-pa
bluedevil
bluez
powerdevil
kscreen
kinfocenter
polkit-kde-agent-1
plasma-systemmonitor
# Graphical software installer: changes in Live mode are temporary.
plasma-discover
# Portable laptop Wi-Fi and audio firmware (may contain redistributable binary firmware).
# Necessary on some Intel/Realtek/Atheros school laptops; does not imply driver coverage for every model.
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-sof-signed
dbus-user-session
xdg-desktop-portal
xdg-desktop-portal-kde
xwayland
python3
python3-venv
python3-pip
# Debian-packaged source-free subtitle parser required by Vosk speech recognition.
python3-srt
python3-gi
python3-gi-cairo
gir1.2-gtk-3.0
gir1.2-webkit2-4.1
ca-certificates
curl
libportaudio2
libasound2t64
libsecret-1-0
ffmpeg
fonts-noto-core
